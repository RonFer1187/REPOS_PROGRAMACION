Algoritmo eje_4_para
	//Desarrolle un algoritmo que calcule el volumen de un cilindro. Para ello, debe solicitar el radio de la base ($r$) y la altura ($h$). Utilice la fórmula
	
	Escribir "Ingrese radio de la base"
	Leer r
	
	Escribir "Ingrese altura"
	Leer h
	
	v<-3.1416*(r*r)*h
	
	Mostrar "El volumen del cilindro es " v " cm3"
	
FinAlgoritmo
